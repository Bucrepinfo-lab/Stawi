# Stawi Expo app — Supabase phone-OTP auth (same project as the web app)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# Base URL of the Stawi web API (/api/mobile/*); token sent as Bearer
EXPO_PUBLIC_API_BASE=https://stawi.app
# Optional shared key matching the web's MOBILE_API_KEY
EXPO_PUBLIC_API_KEY=
