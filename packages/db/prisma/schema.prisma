// Stawi data model — global multi-tenant SaaS. Pillars 1–3 + tenancy.
// Managed Postgres (app on Fly.io). Auth identities come from Supabase phone-OTP,
// stored in the legacy-named clerkUserId / clerkOrgId columns; this schema holds domain data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Multi-tenant SaaS ─────────────────────────

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

/// Top-level billing & isolation boundary. Owns many Groups/Businesses.
model Tenant {
  id          String         @id @default(cuid())
  clerkOrgId  String?        @unique
  name        String
  slug        String         @unique
  countryCode String         @default("KE")
  planTier    PlanTier       @default(FREE)
  groups      Group[]
  members     TenantMember[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TenantMember {
  id          String     @id @default(cuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  clerkUserId String
  role        TenantRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  @@unique([tenantId, clerkUserId])
  @@index([tenantId])
}

// ─────────────────────────── Groups & members ───────────────────────────

enum GroupType {
  CHAMA
  SELF_HELP_GROUP
  SACCO
  BUSINESS
}

enum MemberRole {
  CHAIRMAN
  SECRETARY
  TREASURER
  SIGNATORY
  MEMBER
}

enum SalesTier {
  CONSTITUENCY
  COUNTY
  NATIONAL
  CONTINENTAL
  GLOBAL
  SUPER_ADMIN
}

model Group {
  id          String     @id @default(cuid())
  clerkOrgId  String     @unique
  tenantId    String?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  name        String
  type        GroupType  @default(CHAMA)
  countryCode String     @default("KE")
  flagEmoji   String     @default("🇰🇪")
  formalizationStep Int  @default(0)
  // Which sections this group or business uses (owner 20/11/26). Null = the default for its type.
  // { meetings, agendas, officials, money, ideas, books, savings_credit } — see @stawi/core modules.ts
  modules     Json?
  /// Closed by its owner (owner 28/11/26): hidden from lists and reminders; records kept; can be reopened.
  closedAt    DateTime?

  members       Membership[]
  contributions Contribution[]
  cycles        Cycle[]
  subscription  Subscription?
  business      Business?
  charter       GroupCharter?
  meetings      Meeting[]
  statements    MonthlyStatement[]
  planPayments  PlanPayment[]
  attentionNotices AttentionNotice[]
  messages      GroupMessage[]
  joinCodes     JoinCode[]
  contributionWitnesses ContributionWitness[]
  minutesStandIns MinutesStandIn[]
  tableRounds   TableRound[]
  ideaShortlists IdeaShortlist[]
  contributionChecks    ContributionCheck[]
  corrections           ContributionCorrection[]
  correctionDecisions   CorrectionDecision[]
  salesRepId    String?
  salesRep      SalesAgent? @relation(fields: [salesRepId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Membership {
  id          String     @id @default(cuid())
  clerkUserId String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  fullName    String
  phone       String?
  photoUrl    String?
  role        MemberRole @default(MEMBER)
  rotationOrder Int      @default(0)
  /// Taken off the member list by the secretary or chairperson (owner 28/11/26).
  /// The row and its money records stay; a left member cannot open the group.
  leftAt      DateTime?

  contributions Contribution[]

  joinedAt DateTime @default(now())

  @@unique([groupId, clerkUserId])
  @@index([groupId])
}

// ───────────────────────── Table banking (Pillar 1) ─────────────────────

model Cycle {
  id          String   @id @default(cuid())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  index       Int
  recipientMembershipId String?
  payoutCents Int      @default(0)
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  @@unique([groupId, index])
}

enum PaymentChannel {
  MPESA_STK
  MPESA_C2B
  BANK
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Contribution {
  id           String         @id @default(cuid())
  group        Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  member       Membership     @relation(fields: [membershipId], references: [id])
  membershipId String
  amountCents  Int
  channel      PaymentChannel @default(MPESA_STK)
  status       PaymentStatus  @default(PENDING)
  mpesaRef     String?
  checkoutRequestId String?
  recordedByClerkUserId String?
  receiptUrl   String?
  // Set only on an adjustment entry created when a correction is approved by
  // five people (owner 26/11/26). The original entry is never edited or deleted.
  correctionOfId String?
  createdAt    DateTime       @default(now())

  witnesses   ContributionWitness[]
  check       ContributionCheck?
  corrections ContributionCorrection[]

  @@index([groupId, status])
  @@index([membershipId])
}

// ───────────────────────── Subscriptions / billing ─────────────────────

enum SubStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id           String    @id @default(cuid())
  planTier     PlanTier  @default(FREE)
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String    @unique
  status       SubStatus @default(TRIAL)
  unitPriceCents Int     @default(1000)
  currency     String    @default("USD")
  currentPeriodEnd DateTime?
  termsAcceptedAt DateTime?
  createdAt    DateTime  @default(now())
}

/// A plan payment asked of the way most people in the group's country pay
/// (owner standing order 19/11/26): M-Pesa (Daraja), mobile money (pawaPay) or
/// bank transfer / USSD / EFT (Paystack). PENDING until the provider confirms;
/// the subscription only moves on CONFIRMED, once. `checkoutRequestId` holds
/// the provider's reference (Daraja CheckoutRequestID, pawaPay depositId or
/// Paystack reference).
model PlanPayment {
  id                String        @id @default(cuid())
  group             Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String
  provider          String        @default("mpesa") // mpesa | pawapay | paystack
  checkoutRequestId String        @unique
  tier              PlanTier
  period            String        // MONTH | YEAR
  amountCents       Int
  currency          String        @default("KES")
  status            PaymentStatus @default(PENDING)
  mpesaRef          String?
  requestedByUserId String
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?

  @@index([groupId, status])
}

// ───────────────────────── Business / accounting (Pillar 3) ─────────────

model Business {
  id            String   @id @default(cuid())
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String   @unique
  name          String
  vatRegistered Boolean  @default(false)
  tourismSector Boolean  @default(false)
  taxId         String?

  ventures   SavedVenture[]
  stockItems StockItem[]
  entries    LedgerEntry[]
  createdAt  DateTime @default(now())
  /// SIMPLE | GROWING | BUSY (owner 28/11/26): how much of the books the screens show.
  level      String   @default("SIMPLE")

  bizBranches BizBranch[]
  bizItems    BizItem[]
  bizEntries  BizEntry[]
  bizCloses   BizDayClose[]
  bizStaff    BizStaff[]
  bizSuppliers BizSupplier[]
  bizRestocks  BizRestockRequest[]
}

model SavedVenture {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  title       String
  industry    String
  startupCents Int
  marginPct   Int
  risk        String
  createdAt   DateTime @default(now())
}

model StockItem {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  name        String
  quantity    Int      @default(0)
  reorderLevel Int     @default(5)
  soldInWindow Int     @default(0)
  supplierName String?
  supplierPhone String?
  createdAt   DateTime @default(now())

  @@index([businessId])
}

enum EntryType {
  SALE
  PURCHASE
  EXPENSE
}

model LedgerEntry {
  id          String    @id @default(cuid())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  type        EntryType
  description String
  amountCents Int
  occurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([businessId, occurredAt])
}

// ───────────────────────── Sales hierarchy / admin ─────────────────────

model SalesAgent {
  id          String       @id @default(cuid())
  clerkUserId String       @unique
  fullName    String
  tier        SalesTier
  region      String?
  supervisorId String?
  supervisor   SalesAgent?  @relation("Supervision", fields: [supervisorId], references: [id])
  reports      SalesAgent[] @relation("Supervision")
  groups       Group[]
  createdAt    DateTime     @default(now())
}

// ───────────────────────── Trust & safety ─────────────────────

enum ModerationAction {
  ALLOWED
  FLAGGED
  BLOCKED
}

/// Audit log of moderation decisions on user-generated content.
model ModerationLog {
  id          String           @id @default(cuid())
  clerkUserId String?
  context     String           // e.g. "ledger_entry", "message", "venture"
  action      ModerationAction
  categories  String           // comma-separated
  createdAt   DateTime         @default(now())

  @@index([clerkUserId])
}

// ───────────────────────── SACCO+ Savings & Credit (Pillar 4) ─────────────

enum SaccoEntityType {
  REGISTERED_GROUP
  BUSINESS
  INDIVIDUAL
  INSTITUTION
}

enum SaccoTxnType {
  DEPOSIT
  WITHDRAWAL
  SHARE_PURCHASE
  INTEREST
  DIVIDEND
  REMITTANCE_OUT
  REMITTANCE_IN
}

enum LoanProductId {
  DEVELOPMENT
  EMERGENCY
  BUSINESS_BOOST
}

enum LoanStatus {
  PENDING_SCORE
  APPROVED
  DISBURSED
  REPAYING
  CLEARED
  DEFAULTED
  DECLINED
}

/// A Stawi SACCO+ account. Owner is any entity type; registered Stawi
/// groups are fast-tracked (KYC reused from Pillar 1 formalization).
model SaccoAccount {
  id                String          @id @default(cuid())
  tenantId          String
  entityType        SaccoEntityType
  ownerClerkId      String?         // individual owner
  ownerGroupId      String?         // group/business owner
  displayName       String
  countryCode       String          @default("KE")
  balanceCents      Int             @default(0)
  shareCapitalCents Int             @default(0)
  pledgedCents      Int             @default(0)
  kycComplete       Boolean         @default(false)

  txns  SaccoTxn[]
  loans Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([ownerClerkId])
}

model SaccoTxn {
  id          String       @id @default(cuid())
  account     SaccoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  type        SaccoTxnType
  amountCents Int
  channel     PaymentChannel @default(MPESA_STK)
  status      PaymentStatus  @default(PENDING)
  reference   String?
  /// Dual-approval fraud control: second officer confirms disbursements.
  approvedByClerkId String?
  createdAt   DateTime     @default(now())

  @@index([accountId, createdAt])
}

model Loan {
  id             String        @id @default(cuid())
  account        SaccoAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      String
  product        LoanProductId
  status         LoanStatus    @default(PENDING_SCORE)
  principalCents Int
  monthlyRatePct Float
  termMonths     Int
  /// Eligibility snapshot at approval time (score, tier, reasons JSON).
  scoreJson      String?
  disbursedAt    DateTime?
  clearedAt      DateTime?

  guarantors  LoanGuarantor[]
  repayments  LoanRepayment[]

  createdAt DateTime @default(now())

  @@index([accountId, status])
}

model LoanGuarantor {
  id              String @id @default(cuid())
  loan            Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId          String
  guarantorClerkId String
  coverageCents   Int
  accepted        Boolean @default(false)
  createdAt       DateTime @default(now())

  @@index([loanId])
}

model LoanRepayment {
  id          String   @id @default(cuid())
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId      String
  month       Int
  amountCents Int
  paidOnTime  Boolean  @default(true)
  channel     PaymentChannel @default(MPESA_STK)
  createdAt   DateTime @default(now())

  @@index([loanId])
}

// ───────────────── Pillar 1 — data-entry cockpit (charter / minutes) ─────────

model GroupCharter {
  id           String   @id @default(cuid())
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String   @unique
  tenantId     String?
  name         String
  logoUrl      String?
  // MeetingSchedule { venue, days[], startTime, endTime, frequency }
  schedule     Json
  // CharterMember[] { id, serial, fullName, designation, phone, idNumber }
  members      Json
  constitution String   @default("")
  constitutionFileUrl String?
  motto        String   @default("")
  mission      String   @default("")
  vision       String   @default("")
  coreValues   Json     @default("[]")
  notes        String?
  registeredNumber String?
  countryCode  String   @default("KE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

enum MeetingStatus {
  DRAFT
  POSTED
}

model Meeting {
  id            String   @id @default(cuid())
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  tenantId      String?
  meetingNo     Int
  date          String
  venue         String   @default("")
  day           String   @default("")
  startTime     String   @default("")
  endTime       String   @default("")
  chairpersonName String @default("")
  secretaryName String   @default("")
  // AttendanceMark[] { memberId, name, designation?, status }
  attendance    Json     @default("[]")
  // AgendaItem[] { id, order, title, discussion, proposedBy?, secondedBy?, resolution }
  agendas       Json     @default("[]")
  // AobItem[] { id, topic, deliberation }
  aobs          Json     @default("[]")
  // TableBanking { contributions[], fines[], payoutRecipient?, payoutCents?, otherIn[], otherOut[], openingBalanceCents }
  tableBanking  Json     @default("{}")
  adjournmentTime String @default("")
  nextMeetingDate String?
  // Official-edited professional document (paraphrased). Null until generated.
  generatedDoc  String?
  status        MeetingStatus @default(DRAFT)
  postedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, meetingNo])
  @@index([groupId, status])
  @@index([tenantId])
}

model MonthlyStatement {
  id           String   @id @default(cuid())
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  tenantId     String?
  year         Int
  month        Int
  // MonthEndStatement snapshot (members[], finance, resolutions[], narrative[], ...)
  payload      Json
  // Official-edited version of the narrative, if edited before posting.
  editedNarrative Json?
  status       MeetingStatus @default(DRAFT)
  postedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([groupId, year, month])
  @@index([tenantId])
}

// ───────────────────────── Sign-in: PIN + trusted devices ─────────────────────
// Owner standing rule 07/11/26: SMS code on a new device, then a 4-digit PIN on
// that trusted device. Keyed by the auth user id (Supabase). Not tenant-owned;
// only the server touches these. Additive tables only.

model AuthPin {
  userId       String    @id
  /// E.164 phone the account signs in with (phone + PIN on any device, owner 20/11/26).
  phone        String?
  /// bcrypt hash of the 4-digit PIN — the PIN itself is never stored.
  pinHash      String
  failedCount  Int       @default(0)
  lockedAt     DateTime?
  /// Bumped by "sign out of all devices" to rotate the server-held session secret.
  sessionEpoch Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([phone])
}

/// A one-time joining code a group official gives a member (owner 20/11/26):
/// replaces the SMS sign-in code. Tied to one group and one phone, works once,
/// expires after 48 hours, burned after 5 wrong tries. Only a keyed hash is kept.
model JoinCode {
  id          String    @id @default(cuid())
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  /// Last 9 digits of the member's phone.
  phoneKey    String
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  tries       Int       @default(0)
  /// Membership.id of the official who gave it.
  issuedBy    String
  createdAt   DateTime  @default(now())

  @@index([phoneKey])
  @@index([groupId])
}

model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  /// SHA-256 of the random secret in the device cookie (the secret is never stored).
  tokenHash  String    @unique
  /// E.164 phone the device signs in as (shown masked on the PIN screen).
  phone      String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// ───────────────────────── Engagement counts ──────────────────────────────

/// Daily counts of what people view, open, tap and share (owner 20/11/26).
/// Counts only: no user, phone, group, tenant or IP is stored, so this table
/// is not tenant-owned and holds no personal data.
model EngagementCount {
  id    String @id @default(cuid())
  day   String // UTC day, "2026-11-20"
  event String // view | open | cta | share | tab | sort | source
  key   String // e.g. "p1-minutes", "tab-books", "share-whatsapp"
  count Int    @default(0)

  @@unique([day, event, key])
  @@index([day])
}

/// Daily alerts already sent for stalled work (owner approved 20/11/26), so
/// nobody is told twice about the same matter at the same level. Holds the
/// matter's key and the member's row id in the member list — no name, no
/// phone, no message text. Group-owned (listed in rls.sql).
model AttentionNotice {
  id       String   @id @default(cuid())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  key      String // e.g. "minutes_not_posted:<meetingId>"
  level    Int
  memberId String // CharterMember.id
  sentAt   DateTime @default(now())

  @@unique([groupId, key, level, memberId])
  @@index([groupId])
}

/// Messages inside the app (owner 20/11/26). channel ALL = the whole group;
/// OFFICIALS = "ask the officials": seen by the member named in threadMemberId
/// and by the officials only. Plain text, screened before it is stored.
/// Group-owned (listed in rls.sql). No phone number is stored here.
model GroupMessage {
  id                 String   @id @default(cuid())
  group              Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId            String
  channel            String   @default("ALL") // ALL | OFFICIALS
  threadMemberId     String? // Membership.id of the member whose question this is (OFFICIALS only)
  senderMembershipId String
  body               String
  createdAt          DateTime @default(now())

  @@index([groupId, channel, createdAt])
  @@index([groupId, threadMemberId])
}

// ───────────────────────── Trust in the money record (owner 26/11/26) ─────
// A recorded contribution is never edited or deleted. Cash and M-Pesa to an
// official's phone carry two witnesses; each member can confirm or dispute
// money in their name; a correction is a new entry approved by five people.

model ContributionWitness {
  id             String       @id @default(cuid())
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  contributionId String
  membershipId   String // Membership.id of the witness
  confirmedAt    DateTime?
  disputedAt     DateTime?
  note           String?
  createdAt      DateTime     @default(now())

  @@unique([contributionId, membershipId])
  @@index([groupId, membershipId])
}

model ContributionCheck {
  id             String       @id @default(cuid())
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  contributionId String       @unique
  membershipId   String // the member whose money it is
  verdict        String // MINE | WRONG
  note           String?
  createdAt      DateTime     @default(now())

  @@index([groupId, verdict])
}

model ContributionCorrection {
  id                      String       @id @default(cuid())
  group                   Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId                 String
  contribution            Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  contributionId          String
  membershipId            String // whose money it is
  originalCents           Int
  correctedCents          Int
  reason                  String
  requestedByMembershipId String
  status                  String       @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  // [{ slot, membershipId, pickedAt }] — who must approve (see @stawi/core money-trust)
  seats                   Json
  adjustmentId            String? // the Contribution row created on approval
  createdAt               DateTime     @default(now())
  decidedAt               DateTime?

  decisions CorrectionDecision[]

  @@index([groupId, status])
  @@index([contributionId])
}

model CorrectionDecision {
  id           String                 @id @default(cuid())
  group        Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  correction   ContributionCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  correctionId String
  membershipId String
  slot         String
  approve      Boolean
  note         String?
  createdAt    DateTime               @default(now())

  @@unique([correctionId, membershipId])
  @@index([groupId])
}

// ───────────────────────── Phone alerts (owner 26/11/26) ─────────────────
// One row per phone/browser that said yes to Stawi alerts (Web Push). Owned by
// a user, not a group: the server picks the group's members, then their rows.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────── My profile (owner 26/11/26) ───────────────────
// A member's own photo, kept out of Membership so reading a roster never pulls
// image bytes (Telpen Edu moved 346 GB that way). Membership.photoUrl holds
// only the short /api/photo/<userId>?v=<version> link. Per user, like AuthPin.
model ProfilePhoto {
  userId    String   @id
  dataUrl   String
  version   String
  updatedAt DateTime @updatedAt
}

// My email (owner 27/11/26): optional, for receipts, statements and replies;
// never used to sign in. Per user, like ProfilePhoto and AuthPin.
model ProfileContact {
  userId    String   @id
  email     String?
  updatedAt DateTime @updatedAt
}

// Minutes stand-in (owner 27/11/26): only the secretary writes the minutes;
// when the secretary is away the chair or secretary names a member to write
// them until a date, like a lesson cover. Kept as a record of who wrote when.
model MinutesStandIn {
  id                String    @id @default(cuid())
  group             Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String
  membershipId      String // Membership.id of the stand-in
  until             DateTime
  reason            String?
  setByMembershipId String
  createdAt         DateTime  @default(now())
  endedAt           DateTime?

  @@index([groupId, until])
}

// ───────── Table banking round (owner 28/11/26) ─────────
// A record book only: at each meeting one member takes the agreed amount and
// brings it back at the next meeting with the agreed profit. Stawi never moves
// or offers money here. Amounts are whole cents.
model TableRound {
  id                    String    @id @default(cuid())
  group                 Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId               String
  amountCents           Int
  profitCents           Int       @default(0)
  everyDays             Int       @default(7)
  startsOn              DateTime
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  closedAt              DateTime?

  turns TableRoundTurn[]

  @@index([groupId, closedAt])
}

model TableRoundTurn {
  id                     String     @id @default(cuid())
  round                  TableRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId                String
  groupId                String // repeated for the per-group row rule (rls.sql)
  turn                   Int
  membershipId           String
  givenOn                DateTime
  returnOn               DateTime
  givenCents             Int
  returnCents            Int
  givenAt                DateTime?
  givenByMembershipId    String?
  returnedAt             DateTime?
  returnedCents          Int?
  returnedByMembershipId String?

  @@unique([roundId, turn])
  @@index([groupId])
}

// ───────── Business books (owner 28/11/26) ─────────
// Plain entries become double-entry books in @stawi/core (biz-books.ts).
// Nothing is deleted: a mistake is corrected by a reversing entry. Every row
// carries groupId for the per-group row rule (rls.sql). Amounts in cents.

model BizBranch {
  id         String    @id @default(cuid())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  groupId    String
  name       String
  town       String?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([businessId])
  @@index([groupId])
}

model BizItem {
  id         String    @id @default(cuid())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  groupId    String
  name       String
  unit       String    @default("piece")
  priceCents Int       @default(0)
  reorderAt  Int       @default(0)
  service    Boolean   @default(false)
  barcode    String?
  /// Who normally supplies it (owner 28/11/26): the red line asks this supplier.
  supplierId String?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([businessId])
  @@index([groupId])
}

model BizEntry {
  id                     String   @id @default(cuid())
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId             String
  groupId                String
  branchId               String
  kind                   String // BizKind
  amountCents            Int
  channel                String // CASH | MPESA | BANK | CREDIT
  toChannel              String?
  day                    String // YYYY-MM-DD, the business's own day
  itemId                 String?
  qty                    Float?
  costCents              Int?
  party                  String?
  category               String?
  opening                String?
  note                   String?
  etims                  Boolean  @default(false)
  reversesId             String?  @unique
  recordedByMembershipId String
  recordedByName         String
  recordedAt             DateTime @default(now())

  @@index([businessId, day])
  @@index([groupId])
}

model BizDayClose {
  id                   String   @id @default(cuid())
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId           String
  groupId              String
  branchId             String
  day                  String
  expected             Json
  counted              Json
  closedByMembershipId String
  closedByName         String
  closedAt             DateTime @default(now())

  @@unique([branchId, day])
  @@index([groupId])
}

/// A staff member who records for one branch only (least privilege, owner rule 02/11/26).
model BizStaff {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  groupId      String
  membershipId String
  branchId     String
  createdAt    DateTime @default(now())

  @@unique([businessId, membershipId])
  @@index([groupId])
}

/// A supplier the business already buys from (owner 28/11/26). phoneKey (last
/// nine digits) lets a supplier who uses Stawi see requests addressed to them.
model BizSupplier {
  id         String    @id @default(cuid())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  groupId    String
  name       String
  phone      String
  phoneKey   String
  leadDays   Int       @default(1)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([businessId])
  @@index([groupId])
  @@index([phoneKey])
}

/// "Please bring more": a restock request from a shop to its supplier. Nothing
/// is bought or paid here; the shop writes the goods in when they arrive.
model BizRestockRequest {
  id                    String    @id @default(cuid())
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId            String
  groupId               String
  branchId              String
  supplierId            String
  supplierPhoneKey      String
  supplierName          String
  shopName              String
  branchLabel           String
  /// [{ itemId, name, unit, qty | null }]
  lines                 Json
  note                  String?
  status                String    @default("SENT")
  supplierNote          String?
  deliverOn             String?
  createdByMembershipId String
  createdByName         String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  seenAt                DateTime?

  @@index([businessId, createdAt])
  @@index([supplierPhoneKey, createdAt])
  @@index([groupId])
}

// ───────── Group vote on shortlisted business ideas (owner 28/11/26) ─────────
// An official puts 2–3 researched ideas to the vote; one vote per member;
// the chairperson or secretary confirms the choice. Additive only.
model IdeaShortlist {
  id                    String    @id @default(cuid())
  group                 Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId               String
  // string[]: "title|startupCents|marginPct|risk|industry", re-read with ideasFromParams
  ideas                 Json
  capitalCents          Int       @default(0)
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  chosenTitle           String?
  chosenAt              DateTime?
  chosenByMembershipId  String?
  closedAt              DateTime?

  votes IdeaVote[]

  @@index([groupId, closedAt])
}

model IdeaVote {
  id           String        @id @default(cuid())
  shortlist    IdeaShortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  shortlistId  String
  groupId      String // repeated for the per-group row rule (rls.sql)
  membershipId String
  title        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([shortlistId, membershipId])
  @@index([groupId])
}
