# ─────────────── Stawi environment (copy to .env, never commit .env) ───────────────

# Database — managed PostgreSQL (e.g. Neon / Fly Postgres, EU region). Set on Fly
# with `fly secrets set DATABASE_URL=...` (see DEPLOYMENT-RUNBOOK.md).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stawi?sslmode=require"

# Web auth — Supabase phone OTP (https://supabase.com → Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"
# Supabase Send-SMS hook secret (Auth → Hooks → Send SMS); format v1,whsec_<base64>
SUPABASE_SEND_SMS_HOOK_SECRET="v1,whsec_..."
AT_SENDER_ID=""                            # optional AT alphanumeric sender / short code
# Mobile bridge: the web /api/mobile routes verify the Expo app's Supabase session
# JWT (HS256) with this secret (Supabase → Settings → API → JWT Secret).
SUPABASE_JWT_SECRET="<supabase jwt secret>"

# M-Pesa Daraja (SANDBOX first) — https://developer.safaricom.co.ke
MPESA_ENV="sandbox"                         # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"                    # sandbox paybill
MPESA_PASSKEY=""                            # Daraja sandbox Lipa na M-Pesa passkey
MPESA_CALLBACK_URL="https://YOUR_APP/api/mpesa/callback"
# Sandbox test payer phone for STK Push: 254708374149

# SMS / notifications — Africa's Talking (https://africastalking.com)
AT_USERNAME=""
AT_API_KEY=""

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Global payment providers (each no-op until keyed; provider chosen per country)
STRIPE_SECRET_KEY=""              # cards — US/EU/UK/global
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""            # Nigeria/Ghana/South Africa
FLW_SECRET_KEY=""                 # Flutterwave — pan-African

# Multi-tenant routing
NEXT_PUBLIC_ROOT_DOMAIN="stawi.app"


# Cron (scheduled jobs: subscription dunning; SACCO+ interest accrual only when enabled)
CRON_SECRET=

# SACCO+ (Pillar 4: loan products, credit scoring, loan applications, deposit
# interest accrual, withdrawals/remittances). OFF by default — v1 ships to
# Google Play without lending (Play requires a CBK digital-credit licence for
# Kenyan loan apps). When off, the routes 404, server actions refuse, the db
# repo refuses, the cron skips interest and no loan/interest wording renders.
# Existing SACCO+ rows are left untouched. Set to "true" only once licensed.
SACCO_PLUS_ENABLED=

# Visibility grading — clerk user ids (comma-separated) who see the super-admin view
SUPER_ADMIN_CLERK_IDS=

# ── Member statement explanations - Anthropic (optional) ──
# Opt-in AI pass that rephrases a member's own monthly figures into a plain-
# language note. Default build (no provider) uses the deterministic template —
# offline, free, no key. The AI pass gives NO financial advice and never moves
# money; the core re-screens its output and falls back to the template on
# anything empty/unsafe. Fails closed without a key.
# MEMBER_EXPLANATION_PROVIDER=anthropic|live enables it (needs ANTHROPIC_API_KEY).
# MEMBER_EXPLANATION_PROVIDER=development keeps the template only.
MEMBER_EXPLANATION_PROVIDER=
MEMBER_EXPLANATION_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# ── Android TWA (Google Play, package ke.stawi.app) ──
# SHA-256 signing-cert fingerprints served at /.well-known/assetlinks.json,
# comma-separated: the upload key AND the Play App Signing key
# (Play Console → Setup → App integrity). Format AA:BB:...(32 bytes).
ANDROID_CERT_FINGERPRINTS=
