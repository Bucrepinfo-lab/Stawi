# ─────────────── Stawi environment (copy to .env, never commit .env) ───────────────

# Database — DigitalOcean Managed PostgreSQL (fra1)
# https://cloud.digitalocean.com/databases
DATABASE_URL="postgresql://USER:PASSWORD@HOST:25060/stawi?sslmode=require"

# Web auth — Supabase phone OTP (https://supabase.com → Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"
# Supabase Send-SMS hook secret (Auth → Hooks → Send SMS); format v1,whsec_<base64>
SUPABASE_SEND_SMS_HOOK_SECRET="v1,whsec_..."
AT_SENDER_ID=""                            # optional AT alphanumeric sender / short code
# Mobile bridge only: the Expo app still authenticates with Clerk; the web mobile
# API (lib/mobileApi) verifies its bearer tokens. Remove once mobile moves to Supabase.
CLERK_SECRET_KEY="sk_test_..."

# M-Pesa Daraja (SANDBOX first) — https://developer.safaricom.co.ke
MPESA_ENV="sandbox"                         # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"                    # sandbox paybill
MPESA_PASSKEY=""                            # Daraja sandbox Lipa na M-Pesa passkey
MPESA_CALLBACK_URL="https://YOUR_APP/api/mpesa/callback"
# Sandbox test payer phone for STK Push: 254708374149

# DigitalOcean Spaces (object storage / receipts CDN, fra1)
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_BUCKET="stawi"
DO_SPACES_REGION="fra1"
DO_SPACES_CDN="https://stawi.fra1.cdn.digitaloceanspaces.com"

# SMS / notifications — Africa's Talking (https://africastalking.com)
AT_USERNAME=""
AT_API_KEY=""

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Global payment providers (each no-op until keyed; provider chosen per country)
STRIPE_SECRET_KEY=""              # cards — US/EU/UK/global
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""            # Nigeria/Ghana/South Africa
FLW_SECRET_KEY=""                 # Flutterwave — pan-African

# Multi-tenant routing
NEXT_PUBLIC_ROOT_DOMAIN="stawi.app"


# Cron (scheduled jobs: interest accrual, dunning)
CRON_SECRET=

# Visibility grading — clerk user ids (comma-separated) who see the super-admin view
SUPER_ADMIN_CLERK_IDS=
