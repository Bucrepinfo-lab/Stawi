# ─────────────── Stawi environment (copy to .env, never commit .env) ───────────────

# Database — managed PostgreSQL (e.g. Neon / Fly Postgres, EU region). Set on Fly
# with `fly secrets set DATABASE_URL=...` (see DEPLOYMENT-RUNBOOK.md).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stawi?sslmode=require"

# Web auth — Supabase holds the logins; sign-in is phone + PIN, no SMS (owner 20/11/26)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"
# Mobile bridge: the web /api/mobile routes verify the Expo app's Supabase session
# JWT (HS256) with this secret (Supabase → Settings → API → JWT Secret).
SUPABASE_JWT_SECRET="<supabase jwt secret>"

# M-Pesa Daraja — https://developer.safaricom.co.ke
# Treasurer-initiated STK Push collection only (no B2C / payouts).
# MPESA_ENV picks the base URL: sandbox → sandbox.safaricom.co.ke,
# production → api.safaricom.co.ke. Every value below comes from env; production
# refuses the public sandbox shortcode (174379) and non-https callbacks.
MPESA_ENV="sandbox"                         # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                          # your paybill (sandbox testing: Safaricom's test shortcode)
MPESA_PASSKEY=""                            # Lipa na M-Pesa Online passkey for that shortcode
MPESA_CALLBACK_URL="https://stawi.fly.dev/api/mpesa/callback"
MPESA_CALLBACK_TOKEN=""                     # optional random string; appended as ?token= and checked by the callback

# No SMS provider (owner 20/11/26): sign-in uses joining codes from officials,
# alerts and receipts go to the app's Messages. Africa's Talking is not used.

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Global payment providers (each no-op until keyed; provider chosen per country)
STRIPE_SECRET_KEY=""              # cards — US/EU/UK/global
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""            # Nigeria/Ghana/South Africa
FLW_SECRET_KEY=""                 # Flutterwave — pan-African

# Multi-tenant routing
NEXT_PUBLIC_ROOT_DOMAIN="stawi.app"


# Cron (scheduled jobs: subscription dunning; SACCO+ interest accrual only when enabled)
CRON_SECRET=

# SACCO+ (Pillar 4: loan products, credit scoring, loan applications, deposit
# interest accrual, withdrawals/remittances). OFF by default — v1 ships to
# Google Play without lending (Play requires a CBK digital-credit licence for
# Kenyan loan apps). When off, the routes 404, server actions refuse, the db
# repo refuses, the cron skips interest and no loan/interest wording renders.
# Existing SACCO+ rows are left untouched. Set to "true" only once licensed.
SACCO_PLUS_ENABLED=

# Visibility grading — clerk user ids (comma-separated) who see the super-admin view
SUPER_ADMIN_CLERK_IDS=

# ── Member statement explanations - Anthropic (optional) ──
# Opt-in AI pass that rephrases a member's own monthly figures into a plain-
# language note. Default build (no provider) uses the deterministic template —
# offline, free, no key. The AI pass gives NO financial advice and never moves
# money; the core re-screens its output and falls back to the template on
# anything empty/unsafe. Fails closed without a key.
# MEMBER_EXPLANATION_PROVIDER=anthropic|live enables it (needs ANTHROPIC_API_KEY).
# MEMBER_EXPLANATION_PROVIDER=development keeps the template only.
MEMBER_EXPLANATION_PROVIDER=
MEMBER_EXPLANATION_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# ── Android TWA (Google Play, package ke.stawi.app) ──
# SHA-256 signing-cert fingerprints served at /.well-known/assetlinks.json,
# comma-separated: the upload key AND the Play App Signing key
# (Play Console → Setup → App integrity). Format AA:BB:...(32 bytes).
ANDROID_CERT_FINGERPRINTS=

# ── Google Play reviewer access (remove after review) ──
# When both are set, PLAY_REVIEW_PHONE signs in with the 4-digit PLAY_REVIEW_PIN
# on the normal phone + PIN screen (give both to Google in Play Console →
# App access). Seed it into the demo group: npx tsx packages/db/prisma/seed-demo.ts
# Needs SUPABASE_SERVICE_ROLE_KEY (server-only) to provision the reviewer login.
PLAY_REVIEW_PHONE=
PLAY_REVIEW_PIN=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sign-in: phone + PIN, joining codes, trusted devices (owner 20/11/26) ──
# Phone number + 4-digit PIN on any device; the first time, a joining code from
# a group official. Needs DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY and this
# secret (long random string, e.g. `openssl rand -base64 48`); unset = sign-in
# closed. It also signs joining codes: rotating it voids open codes and every
# trusted device (people sign in again with phone + PIN). Unset = a secret
# derived from SUPABASE_SERVICE_ROLE_KEY is used.
AUTH_DEVICE_SECRET=
# Owner bootstrap: a phone in OWNER_PHONES (comma-separated) may use the fixed
# 6-digit OWNER_BOOTSTRAP_CODE as its joining code (account from before PINs,
# or locked out with no other official). Unset both after use.
OWNER_PHONES=
OWNER_BOOTSTRAP_CODE=
